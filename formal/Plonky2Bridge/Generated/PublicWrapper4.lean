theorem decNulls (a : Assignment p) :
    ∀ t ∈ rows a, t.1.nulls.map valDigest = t.2.nullifiers := by
  intro t ht
  rw [show rows a = List.ofFn (fun i => (row a i, inner a i)) from rfl] at ht
  obtain ⟨i, rfl⟩ := List.mem_ofFn.mp ht
  rfl

