/-- **The recorded public-batch wrapper satisfies `RPublicBatch`.** Every satisfying
    assignment decodes to an `RPublicBatch` instance on the 2 inner outputs, the
    aggregator address and the aggregated output; the oracle is irrelevant (the wrapper
    hashes nothing). -/
theorem sound (ro : RandomOracle) (hpg : WormholeSpec.goldilocks ≤ p)
    (a : Assignment p) (h : Satisfies (publicBatchWrapper2 p) a) :
    RPublicBatch ro (inners a) (addr a) (out a) := by
  obtain ⟨kzero, ktot, kone, kslots⟩ := consts a h
  have hblk : ∀ j, a (![.wire 4 31, .wire 4 39, .wire 4 47, .wire 4 55] j) = blockRef (rows a) j := by
    intro j
    fin_cases j
    · exact blockLimb_0 a h
    · exact blockLimb_1 a h
    · exact blockLimb_2 a h
    · exact blockLimb_3 a h
  have hb0 : a (.wire 4 31) = blockRef (rows a) 0 := hblk 0
  have hb1 : a (.wire 4 39) = blockRef (rows a) 1 := hblk 1
  have hb2 : a (.wire 4 47) = blockRef (rows a) 2 := hblk 2
  have hb3 : a (.wire 4 55) = blockRef (rows a) 3 := hblk 3
  have hsnR := scan_sn a h
  have hsaR := scan_sa a h
  have hsfR := scan_sf a h
  refine public_batch_val ro (rows a) (k := 2) rfl
    (dummyAll a h) (decBlock a) (decNum a) (decAsset a) (decFee a)
    (decSlots a) (decNulls a) ?_ ?_ ?_ ?_
    (assetAll a h) (feeAll a h) (blockAll a h)
    (exitFwd a h) (nullFwd a h) (shapeAll a) (countAll a h hpg) ?_
  · -- header: block hash
    show (⟨(a (.wire 4 31)).val, (a (.wire 4 39)).val, (a (.wire 4 47)).val, (a (.wire 4 55)).val⟩ : Digest)
      = ⟨(blockRef (rows a) 0).val, (blockRef (rows a) 1).val, (blockRef (rows a) 2).val,
          (blockRef (rows a) 3).val⟩
    rw [hb0, hb1, hb2, hb3]
  · show (a (.wire 4 63)).val = _
    rw [hsnR]
  · show (a (.wire 4 71)).val = _
    rw [hsaR]
  · show (a (.wire 4 79)).val = _
    rw [hsfR]
  · show (a (.virt 27)).val = 2 * 2
    rw [ktot]
    have hc : (4 : ℕ) < p := lt_of_lt_of_le (by decide) hpg
    rw [← Nat.cast_ofNat, ZMod.val_natCast_of_lt hc]

/-! ### The wrapper as a recursion tree (PLAN.md Step 10) -/

/-- The wrapper with its recursion gadgets: `verify_proof` under the `2`-leaf private-batch
    verifier key on each `inner_pis_i`. -/
noncomputable def tree : Recursive p :=
  .node "public_batch_wrapper_n2" (publicBatchWrapper2 p)
    [(Wrapper2.tree, List.ofFn (innerPis 0)),
     (Wrapper2.tree, List.ofFn (innerPis 1))]

theorem pisEq_0 :
    List.ofFn (innerPis 0) = (publicBatchWrapper2.verifiers[0]'(by decide)).2 := by
  rfl

theorem pisEq_1 :
    List.ofFn (innerPis 1) = (publicBatchWrapper2.verifiers[1]'(by decide)).2 := by
  rfl

/-- The tree's gadgets are the recorded ones. -/
theorem tree_verifiers : (tree (p := p)).verifiers = publicBatchWrapper2.verifiers := by
  have htag : Wrapper2.tree.tag (p := p) = "private_batch_wrapper_n2" := by
    simp only [Recursive.tag, Wrapper2.tree]
  rw [Recursive.verifiers, tree, Recursive.children]
  rw [List.map_cons, htag, pisEq_0]
  rw [List.map_cons, htag, pisEq_1]
  rw [List.map_nil]
  rfl

omit [Fact p.Prime] in
set_option maxRecDepth 8192 in
/-- Inner `i`'s public inputs, as the wrapper reads them, are the private-batch wrapper's
    `outOf`. -/
theorem inner_eq (a : Assignment p) (i : Fin 2) :
    inner a i = Wrapper2.outOf (a ∘ innerPis i) := by
  fin_cases i <;> rfl

/-- **The public-batch capstone on the recorded wiring.** `public_batch_end_to_end` with its
    decode hypotheses discharged by `sound`: a satisfying assignment of the `n_inner = 2`
    public-batch wrapper whose recursion gadgets accepted every inner private-batch proof
    (i) satisfies `RPublicBatch`, (ii) has the slot-count header equal to the sum of the
    inners' slot counts and (iii) attests every inner's `RPrivateBatch` — through
    `proof_sound` on the good events `hgw` for the inner wrapper's proofs and `hgl` for the
    leaf proofs, and the wired wrapper bridges below it. -/
theorem end_to_end_wired (perm : St p → St p) (hpg : WormholeSpec.goldilocks ≤ p)
    (hgw : GoodEvents perm Wrapper2.tree) (hgl : GoodEvents perm LeafCircuit.tree)
    (a : Assignment p) (h : Satisfies (publicBatchWrapper2 p) a)
    (hacc : ∀ i : Fin 2, ProofAccepted perm Wrapper2.tree ((List.ofFn (innerPis i)).map a)) :
    RPublicBatch (spongeRO perm) (inners a) (addr a) (out a)
      ∧ (out a).totalExitSlots = ((inners a).map fun o => o.exitSlots.length).sum
      ∧ ∀ o ∈ inners a, ∃ leaves us, RPrivateBatch (spongeRO perm) leaves us o := by
  have hR := sound (spongeRO perm) hpg a h
  refine ⟨hR, RPublicBatch_totalExitSlots hR, ?_⟩
  intro o ho
  rw [show inners a = List.ofFn (inner a) from rfl] at ho
  obtain ⟨i, rfl⟩ := List.mem_ofFn.mp ho
  rw [inner_eq]
  exact Wrapper2.accepted_sound perm hpg hgw hgl (hacc i)

