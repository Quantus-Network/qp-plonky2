    rw [← hd, ← (publicBatchWrapper2_f63 a h), ← (publicBatchWrapper2_f64 a h), ← (publicBatchWrapper2_f65 a h), ← (publicBatchWrapper2_f66 a h), (publicBatchWrapper2_f67 a h), kone]

