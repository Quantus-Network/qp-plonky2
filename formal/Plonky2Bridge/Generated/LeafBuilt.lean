/-- Every constant target of the export is pinned in the certificate. -/
theorem checks_constants : buildCert.constsOk 0 constTargets constWits = true := by
  decide +kernel

/-- **A build the certificate describes refines the export.** `Built.Agrees.refines`
    on the checks above. -/
theorem build_refines_of_agrees (b : Built p) (h : b.Agrees (leafCircuit p) buildCert) :
    b.Refines (leafCircuit p) :=
  h.refines (le_of_eq rows_length) (by rw [rowKinds_eq]; exact checks_rows)
    (by rw [copies_eq]; exact checks_copies) (by rw [constants_fst]; exact checks_constants)
    publicInputs_length.symm

/-- The public-input hash is wired in the certificate: the sponge over the export's
    public inputs through the hash rows into the `PublicInputGate`. -/
theorem checks_pi : buildCert.piOk piTargets buildCert.hashRows hashWits outWits = true := by
  decide +kernel

/-- **A build the certificate describes hashes the export's public inputs.**
    `Built.Agrees.hashesPublicInputs` on `checks_pi`. -/
theorem build_hashes_of_agrees (b : Built p) (h : b.Agrees (leafCircuit p) buildCert) :
    b.HashesPublicInputs (leafCircuit p) :=
  h.hashesPublicInputs (by rw [publicInputs_targets]; exact checks_pi)

end Plonky2Bridge.LeafCircuit
