/-- **The capstone on the recorded wiring.** `private_batch_end_to_end` with its decode
    hypotheses discharged by `sound`: a satisfying assignment of the `n = 8` private-batch
    wrapper whose recursion gadgets accepted every child leaf proof (i) satisfies
    `RPrivateBatch`, (ii) settles at most the masked input total, (iii) settles at most the
    real inputs with distinct spends and (iv) attests every child's `Rleaf` — through
    `proof_sound` on the good events `hgl` for the leaf proofs, and `leaf_wired`. -/
theorem end_to_end_wired (perm : St p → St p) (hpg : WormholeSpec.goldilocks ≤ p)
    (hgl : GoodEvents perm LeafCircuit.tree)
    (a : Assignment p) (h : Satisfies (privateBatchWrapper8 p) a)
    (hp : Poseidon2Rows perm (privateBatchWrapper8 p) a)
    (hacc : ∀ i : Fin 8, ProofAccepted perm LeafCircuit.tree ((List.ofFn (leafPis i)).map a)) :
    RPrivateBatch (spongeRO perm) (leaves a) (us a) (out a)
      ∧ outputExitTotal (out a) ≤ maskedInputTotal (leaves a)
      ∧ (outputExitTotal (out a) ≤ rawInputTotal (realLeaves (leaves a))
          ∧ (realNullifiers (leaves a)).Nodup)
      ∧ ∀ pub ∈ leaves a, ∃ w : LeafWitness, Rleaf (spongeRO perm) pub w := by
  have hleaf : ∀ pub ∈ leaves a, ∃ w : LeafWitness, Rleaf (spongeRO perm) pub w := by
    intro pub hq
    simp only [leaves, List.mem_cons, List.mem_nil_iff, or_false] at hq
    rcases hq with rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl
    · rw [row_leaf]; exact LeafCircuit.accepted_sound perm hpg hgl (hacc 0)
    · rw [row_leaf]; exact LeafCircuit.accepted_sound perm hpg hgl (hacc 1)
    · rw [row_leaf]; exact LeafCircuit.accepted_sound perm hpg hgl (hacc 2)
    · rw [row_leaf]; exact LeafCircuit.accepted_sound perm hpg hgl (hacc 3)
    · rw [row_leaf]; exact LeafCircuit.accepted_sound perm hpg hgl (hacc 4)
    · rw [row_leaf]; exact LeafCircuit.accepted_sound perm hpg hgl (hacc 5)
    · rw [row_leaf]; exact LeafCircuit.accepted_sound perm hpg hgl (hacc 6)
    · rw [row_leaf]; exact LeafCircuit.accepted_sound perm hpg hgl (hacc 7)
  have hR := sound perm hpg a h hp fun q hq =>
    let ⟨_, hw⟩ := hleaf q hq
    Rleaf_ranges hw
  exact ⟨hR, RPrivateBatch_settlement_le_input hR, RPrivateBatch_settles_distinct_spends hR, hleaf⟩

